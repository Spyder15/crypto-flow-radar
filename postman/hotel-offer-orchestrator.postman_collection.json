{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "_postman_id": "b6f2a2f0-1a1d-4b3e-9e4a-hotel-orchestrator",
    "description": "Test collection for the Hotel Offer Orchestrator API (Temporal + Redis + mock suppliers).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Supplier A - Raw Hotels (Delhi)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/supplierA/hotels?city=delhi",
          "host": ["{{baseUrl}}"],
          "path": ["supplierA", "hotels"],
          "query": [{ "key": "city", "value": "delhi" }]
        }
      }
    },
    {
      "name": "Supplier B - Raw Hotels (Delhi)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/supplierB/hotels?city=delhi",
          "host": ["{{baseUrl}}"],
          "path": ["supplierB", "hotels"],
          "query": [{ "key": "city", "value": "delhi" }]
        }
      }
    },
    {
      "name": "Get Hotels - Valid City with Overlaps (Delhi)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is a de-duplicated array', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(Array.isArray(body)).to.be.true;",
              "  const names = body.map(h => h.name.toLowerCase());",
              "  pm.expect(new Set(names).size).to.eql(names.length);",
              "});",
              "pm.test('Holtin resolved to cheaper Supplier B offer', function () {",
              "  const body = pm.response.json();",
              "  const holtin = body.find(h => h.name === 'Holtin');",
              "  if (holtin) {",
              "    pm.expect(holtin.price).to.eql(5340);",
              "    pm.expect(holtin.supplier).to.eql('Supplier B');",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [{ "key": "city", "value": "delhi" }]
        }
      }
    },
    {
      "name": "Get Hotels - City With No Results",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is an empty array', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(Array.isArray(body)).to.be.true;",
              "  pm.expect(body.length).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=atlantis",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [{ "key": "city", "value": "atlantis" }]
        }
      }
    },
    {
      "name": "Get Hotels - Missing City Param (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/hotels", "host": ["{{baseUrl}}"], "path": ["api", "hotels"] }
      }
    },
    {
      "name": "Get Hotels - Filtered by Price Range (Delhi, 5000-10000)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('All hotels are within price range', function () {",
              "  const body = pm.response.json();",
              "  body.forEach(h => {",
              "    pm.expect(h.price).to.be.at.least(5000);",
              "    pm.expect(h.price).to.be.at.most(10000);",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=10000",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [
            { "key": "city", "value": "delhi" },
            { "key": "minPrice", "value": "5000" },
            { "key": "maxPrice", "value": "10000" }
          ]
        }
      }
    },
    {
      "name": "Get Hotels - Mumbai (Overlap Set 2)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=mumbai",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [{ "key": "city", "value": "mumbai" }]
        }
      }
    },
    {
      "name": "Get Hotels - Goa (Overlap Set 3)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=goa",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [{ "key": "city", "value": "goa" }]
        }
      }
    }
  ]
}
