//@version=5
strategy("Gold SMC Pro v3 (optimized)", shorttitle = "SMC Pro v3", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_order, commission_value = 0.2, max_boxes_count = 300, max_lines_count = 300, max_labels_count = 300)

// WARNING: earlier headers claimed +0.35R / 40% win. That came from a backtest lookahead bug (a close through the zone cancelled
// the order before the entry-hit check). With the bug fixed, GC=F 1H gives -0.21 / -0.05 / -0.10 R across 3 folds, and 39 Binance perps
// lose money after fees. No validated edge: use this as a visual study tool / for forward testing only, not as a proven strategy.
// Chart: swing points, BOS (continuation) / CHoCH (reversal) lines, FVG boxes (end when filled), entry/SL/TP, accuracy table.
// Signal gate: new trades are skipped while the rolling win rate of the last N closed trades is below your minimum.
grpA = "Structure"
pv       = input.int(2, "Swing pivot length", minval = 1, group = grpA)
lookbk   = input.int(20, "FVG must form within N bars of break", minval = 1, group = grpA)
minFvg   = input.float(0.0, "Min FVG size (x ATR)", step = 0.1, group = grpA)
maxWait  = input.int(40, "Cancel entry after N bars", minval = 1, group = grpA)
onlyCho  = input.bool(false, "Only trade after CHoCH (reversal)", group = grpA)
entFrac  = input.float(0.75, "Entry depth in FVG (0 = near edge, 1 = far edge)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpA)
useSess  = input.bool(true, "Only place setups in session (UTC hours)", group = grpA)
sessS    = input.int(12, "Session start (UTC)", minval = 0, maxval = 23, group = grpA)
sessE    = input.int(22, "Session end (UTC)", minval = 1, maxval = 24, group = grpA)
grpB = "Risk"
rr       = input.float(2.5, "Reward (R)", minval = 0.5, step = 0.5, group = grpB)
slBuf    = input.float(0.5, "SL buffer beyond FVG (x ATR)", step = 0.1, group = grpB)
useTrend = input.bool(false, "Only trade with EMA 100 trend", group = grpB)
grpC = "Accuracy gate"
useGate  = input.bool(true, "Skip signals when rolling accuracy is low", group = grpC)
lastN    = input.int(20, "Rolling window (closed trades)", minval = 5, maxval = 100, group = grpC)
minTr    = input.int(8, "Gate active after N trades", minval = 1, group = grpC)
minWR    = input.float(30.0, "Min rolling win % (breakeven at 1:2.5 = 29%)", minval = 0.0, maxval = 100.0, group = grpC)
grpD = "Display"
showFvg  = input.bool(true, "FVG boxes", group = grpD)
showStr  = input.bool(true, "BOS / CHoCH lines", group = grpD)
showSw   = input.bool(true, "Swing points", group = grpD)

atr = ta.atr(14)
ema = ta.ema(close, 100)

ph = ta.pivothigh(high, pv, pv)
pl = ta.pivotlow(low, pv, pv)
var float swH = na
var float swL = na
var int swHBar = 0
var int swLBar = 0
var int bias = 0
var int brkBar = -1000
var bool lastCho = false

if not na(ph)
    swH := ph
    swHBar := bar_index - pv
    if showSw
        label.new(bar_index - pv, ph, "", style = label.style_circle, color = color.new(color.gray, 20), size = size.tiny)
if not na(pl)
    swL := pl
    swLBar := bar_index - pv
    if showSw
        label.new(bar_index - pv, pl, "", style = label.style_circle, color = color.new(color.gray, 20), size = size.tiny)

bool brkDn = not na(swL) and close < swL and close[1] >= swL
bool brkUp = not na(swH) and close > swH and close[1] <= swH

if brkDn
    bool cho = bias == 1
    if showStr
        line.new(swLBar, swL, bar_index, swL, color = cho ? color.orange : color.gray, width = 1)
        label.new(math.round((swLBar + bar_index) / 2), swL, cho ? "CHoCH" : "BOS", style = label.style_label_up, color = color.new(color.black, 100), textcolor = cho ? color.orange : color.gray, size = size.small)
    lastCho := cho
    bias := -1
    brkBar := bar_index
    swL := na
if brkUp
    bool cho = bias == -1
    if showStr
        line.new(swHBar, swH, bar_index, swH, color = cho ? color.orange : color.gray, width = 1)
        label.new(math.round((swHBar + bar_index) / 2), swH, cho ? "CHoCH" : "BOS", style = label.style_label_down, color = color.new(color.black, 100), textcolor = cho ? color.orange : color.gray, size = size.small)
    lastCho := cho
    bias := 1
    brkBar := bar_index
    swH := na

// ---- FVG boxes (all gaps drawn, extended until price closes through them) ----
bool anyBear = high < low[2] and (low[2] - high) >= minFvg * atr
bool anyBull = low > high[2] and (low - high[2]) >= minFvg * atr
var boxes = array.new_box()
var bSide = array.new_int()
if showFvg and bar_index > 2
    if anyBear
        array.push(boxes, box.new(bar_index - 2, low[2], bar_index, high, bgcolor = color.new(color.red, 82), border_color = color.new(color.red, 60)))
        array.push(bSide, -1)
    if anyBull
        array.push(boxes, box.new(bar_index - 2, low, bar_index, high[2], bgcolor = color.new(color.green, 82), border_color = color.new(color.green, 60)))
        array.push(bSide, 1)
    int k = array.size(boxes) - 1
    while k >= 0
        box bx = array.get(boxes, k)
        int sd = array.get(bSide, k)
        float tp_ = box.get_top(bx)
        float bt_ = box.get_bottom(bx)
        bool dead = (sd == -1 and close > tp_) or (sd == 1 and close < bt_) or (bar_index - box.get_left(bx) > 300)
        if dead
            box.set_right(bx, bar_index)
            array.remove(boxes, k)
            array.remove(bSide, k)
        else
            box.set_right(bx, bar_index + 1)
        k := k - 1

// ---- setup + entry ----
int hr = hour(time, "UTC")
bool inSess = not useSess or (hr >= sessS and hr < sessE)
bool okType = (not onlyCho or lastCho) and inSess
bool bearFvg = anyBear and bias == -1 and bar_index - brkBar <= lookbk and okType and (not useTrend or close < ema)
bool bullFvg = anyBull and bias == 1 and bar_index - brkBar <= lookbk and okType and (not useTrend or close > ema)

// rolling accuracy of the last N closed trades
int nCl = strategy.closedtrades
int nUse = math.min(nCl, lastN)
int wn = 0
for i = 0 to nUse - 1
    if strategy.closedtrades.profit(nCl - 1 - i) > 0
        wn := wn + 1
float rwr = nUse > 0 ? wn * 100.0 / nUse : na
bool gateOk = not useGate or nCl < minTr or rwr >= minWR

var float pTop = na
var float pBot = na
var int pSide = 0
var int pBar = 0
var int nSetups = 0
var int nBlockedSess = 0
var int nBlockedGate = 0

if (bearFvg or bullFvg) and strategy.position_size == 0 and gateOk
    strategy.cancel("S")
    strategy.cancel("L")
    pSide := bearFvg ? -1 : 1
    pTop := bearFvg ? low[2] : low
    pBot := bearFvg ? high : high[2]
    pBar := bar_index
    float md = pSide == -1 ? pBot + (pTop - pBot) * entFrac : pTop - (pTop - pBot) * entFrac
    nSetups := nSetups + 1
    float stS = pSide == -1 ? pTop + slBuf * atr : pBot - slBuf * atr
    float tpS = md + (pSide == -1 ? -1 : 1) * rr * math.abs(stS - md)
    label.new(bar_index, pSide == -1 ? high : low, (pSide == -1 ? "SELL SETUP\nLimit " : "BUY SETUP\nLimit ") + str.tostring(md, "#.0") + "\nSL " + str.tostring(stS, "#.0") + "\nTP " + str.tostring(tpS, "#.0"), style = pSide == -1 ? label.style_label_down : label.style_label_up, color = color.new(pSide == -1 ? color.red : color.green, 30), textcolor = color.white, size = size.small)
    if pSide == -1
        float st = pTop + slBuf * atr
        strategy.entry("S", strategy.short, limit = md)
        strategy.exit("xS", "S", stop = st, limit = md - rr * (st - md))
    else
        float st = pBot - slBuf * atr
        strategy.entry("L", strategy.long, limit = md)
        strategy.exit("xL", "L", stop = st, limit = md + rr * (md - st))

if pSide != 0 and strategy.position_size == 0 and (bar_index - pBar > maxWait or (pSide == -1 and close > pTop) or (pSide == 1 and close < pBot))
    strategy.cancel("S")
    strategy.cancel("L")
    pSide := 0

if (anyBear and bias == -1 or anyBull and bias == 1) and bar_index - brkBar <= lookbk
    if not inSess
        nBlockedSess := nBlockedSess + 1
    else if not gateOk
        nBlockedGate := nBlockedGate + 1

// entry / SL / TP drawing on fill
bool filled = strategy.position_size != 0 and strategy.position_size[1] == 0
if filled
    float en = strategy.position_avg_price
    bool isL = strategy.position_size > 0
    float stp = isL ? pBot - slBuf * atr : pTop + slBuf * atr
    float tpp = isL ? en + rr * (en - stp) : en - rr * (stp - en)
    line.new(bar_index, stp, bar_index + 25, stp, color = color.red, width = 2)
    line.new(bar_index, tpp, bar_index + 25, tpp, color = color.green, width = 2)
    line.new(bar_index, en, bar_index + 25, en, color = color.white, width = 1, style = line.style_dashed)
    label.new(bar_index, en, (isL ? "BUY " : "SELL ") + str.tostring(en, "#.0") + "\nSL " + str.tostring(stp, "#.0") + "\nTP " + str.tostring(tpp, "#.0") + " (1:" + str.tostring(rr, "#.#") + ")", style = isL ? label.style_label_up : label.style_label_down, color = isL ? color.green : color.red, textcolor = color.white, size = size.small)

// ---- accuracy table ----
var table tb = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 25), border_width = 1)
if barstate.islast
    float tot = strategy.closedtrades
    float w = strategy.wintrades
    float pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    table.cell(tb, 0, 0, "Bias", text_color = color.white)
    table.cell(tb, 1, 0, bias == 1 ? "BULLISH" : bias == -1 ? "BEARISH" : "-", text_color = bias == 1 ? color.lime : color.red)
    table.cell(tb, 0, 1, "Trades", text_color = color.white)
    table.cell(tb, 1, 1, str.tostring(tot, "#"), text_color = color.white)
    table.cell(tb, 0, 2, "Win rate", text_color = color.white)
    table.cell(tb, 1, 2, tot > 0 ? str.tostring(w * 100 / tot, "#.0") + "%" : "-", text_color = color.white)
    table.cell(tb, 0, 3, "Rolling " + str.tostring(nUse), text_color = color.white)
    table.cell(tb, 1, 3, nUse > 0 ? str.tostring(rwr, "#.0") + "%" : "-", text_color = gateOk ? color.lime : color.red)
    table.cell(tb, 0, 4, "Profit factor", text_color = color.white)
    table.cell(tb, 1, 4, na(pf) ? "-" : str.tostring(pf, "#.00"), text_color = color.white)
    table.cell(tb, 0, 5, "Net P/L", text_color = color.white)
    table.cell(tb, 1, 5, str.tostring(strategy.netprofit, "#"), text_color = strategy.netprofit >= 0 ? color.lime : color.red)
    table.cell(tb, 0, 6, "Signals", text_color = color.white)
    table.cell(tb, 1, 6, gateOk ? "ON" : "PAUSED (low accuracy)", text_color = gateOk ? color.lime : color.red)

if barstate.islast
    table.cell(tb, 0, 7, "Setups placed", text_color = color.white)
    table.cell(tb, 1, 7, str.tostring(nSetups), text_color = color.white)
    table.cell(tb, 0, 8, "Blocked sess/gate", text_color = color.white)
    table.cell(tb, 1, 8, str.tostring(nBlockedSess) + " / " + str.tostring(nBlockedGate), text_color = color.white)

alertcondition(nSetups > nSetups[1], "SMC SETUP", "Gold SMC setup: limit order placed")
alertcondition(filled and strategy.position_size > 0, "SMC BUY", "Gold SMC BUY filled")
alertcondition(filled and strategy.position_size < 0, "SMC SELL", "Gold SMC SELL filled")
