{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregates overlapping hotel offers from two mock suppliers using Temporal.io, dedupes by hotel name, picks the cheapest offer, and supports Redis-backed price-range filtering.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/temporal/worker.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "temporal",
    "hotel",
    "orchestrator",
    "redis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@temporalio/activity": "^1.11.6",
    "@temporalio/client": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
